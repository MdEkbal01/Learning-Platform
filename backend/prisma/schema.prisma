generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  mobile            String?      @unique
  username          String?      @unique
  passwordHash      String
  name              String
  role              String       @default("STUDENT") // STUDENT, MENTOR, CONTENT_MANAGER, FINANCE_SUPPORT, MODERATOR, SUPER_ADMIN
  isEmailVerified   Boolean      @default(false)
  isMobileVerified  Boolean      @default(false)
  status            String       @default("ACTIVE") // ACTIVE, SUSPENDED
  suspensionReason  String?
  avatarUrl         String?
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  profile           UserProfile?
  sessions          Session[]
  challenges        VerificationChallenge[]
  enrolments        Enrolment[]
  orders            Order[]
  doubtTickets      DoubtTicket[]      @relation("StudentDoubts")
  assignedDoubts    DoubtTicket[]      @relation("MentorDoubts")
  doubtMessages     DoubtMessage[]
  forumTopics       CourseForumTopic[]
  forumPosts        CourseForumPost[]
  moderationReports ModerationReport[] @relation("ReporterReports")
  resolvedReports   ModerationReport[] @relation("ModeratorActions")
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  liveClasses       LiveClass[]        @relation("MentorLiveClasses")
  notifications     Notification[]
  auditLogs         AuditEvent[]       @relation("ActorAuditLogs")
  refundsProcessed  Refund[]           @relation("StaffRefunds")
  mentorCourses     Course[]           @relation("MentorAssignedCourses")
  feedbacks         Feedback[]
  assignedFeedbacks Feedback[]         @relation("StaffAssignedFeedbacks")
  supportTickets    SupportTicket[]
  assignedTickets   SupportTicket[]    @relation("StaffAssignedTickets")
  ticketMessages    SupportTicketMessage[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  college           String?
  academicYear      String?
  academicCourse    String?
  bio               String?
  theme             String   @default("light") // light, dark
  language          String   @default("en")    // en, hi
  notificationPrefs String?  @default("{\"email\":true,\"sms\":false,\"doubts\":true,\"announcements\":true}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationChallenge {
  id         String    @id @default(uuid())
  userId     String?
  identifier String // email or mobile
  type       String // EMAIL_VERIFY, MOBILE_VERIFY, PASSWORD_RESET
  code       String // verification code or token
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  courses     Course[]
  createdAt   DateTime @default(now())
}

model Course {
  id                 String           @id @default(uuid())
  title              String
  slug               String           @unique
  description        String
  shortDescription   String?
  categoryId         String
  level              String           @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  language           String           @default("English")
  durationHours      Float            @default(10)
  price              Float            @default(0)
  isFree             Boolean          @default(false)
  status             String           @default("DRAFT") // DRAFT, IN_REVIEW, PUBLISHED, ARCHIVED
  thumbnail          String?
  previewVideoUrl    String?
  instructorName     String
  mentorId           String?
  accessDurationDays Int              @default(365) // 0 for lifetime
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  category           CourseCategory   @relation(fields: [categoryId], references: [id])
  mentor             User?            @relation("MentorAssignedCourses", fields: [mentorId], references: [id])
  modules            CourseModule[]
  enrolments         Enrolment[]
  orders             Order[]
  doubtTickets       DoubtTicket[]
  forumTopics        CourseForumTopic[]
  liveClasses        LiveClass[]
  certificates       Certificate[]
  resources          CourseResource[]
  feedbacks          Feedback[]
}

model CourseModule {
  id          String       @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quiz        ModuleQuiz?
}

model Lesson {
  id              String           @id @default(uuid())
  moduleId        String
  title           String
  description     String?
  orderIndex      Int              @default(0)
  durationMinutes Int              @default(15)
  videoUrl        String?
  notesMarkdown   String?
  isPreview       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources       CourseResource[]
  progressRecords LessonProgress[]
  doubtTickets    DoubtTicket[]
}

model CourseResource {
  id          String    @id @default(uuid())
  courseId    String?
  lessonId    String?
  title       String
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  isPublic    Boolean   @default(false) // If true, visitors can view; if false, enrolled only
  createdAt   DateTime  @default(now())

  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id                         String   @id @default(uuid())
  userId                     String
  lessonId                   String
  isCompleted                Boolean  @default(false)
  completedAt                DateTime?
  lastPlaybackPositionSeconds Float   @default(0)
  updatedAt                  DateTime @updatedAt

  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson                     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model ModuleQuiz {
  id              String         @id @default(uuid())
  moduleId        String         @unique
  title           String
  passPercentage  Int            @default(70)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  module          CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]
}

model QuizQuestion {
  id          String         @id @default(uuid())
  quizId      String
  question    String
  explanation String?
  orderIndex  Int            @default(0)

  quiz        ModuleQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuizOption[]
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean      @default(false)

  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id         String     @id @default(uuid())
  userId     String
  quizId     String
  score      Int
  maxScore   Int
  percentage Float
  isPassed   Boolean
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       ModuleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String   @id @default(uuid())
  certificateCode String   @unique // e.g. "CERT-2026-A1B2C3D4"
  userId          String
  courseId        String
  studentName     String
  courseTitle     String
  issuedAt        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String               @unique // e.g. "ORD-2026-1001"
  userId         String
  courseId       String
  amount         Float
  currency       String               @default("USD")
  status         String               @default("PENDING") // PENDING, PAID, FAILED, CANCELLED, REFUNDED
  paymentGateway String               @default("SIMULATED_GATEWAY") // SIMULATED_GATEWAY, RAZORPAY, STRIPE
  gatewayOrderId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  course         Course               @relation(fields: [courseId], references: [id])
  transactions   PaymentTransaction[]
  enrolments     Enrolment[]
  refund         Refund?
}

model PaymentTransaction {
  id               String   @id @default(uuid())
  orderId          String
  gatewayPaymentId String?
  gatewaySignature String?
  amount           Float
  currency         String   @default("USD")
  status           String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  rawResponseJson  String?
  createdAt        DateTime @default(now())

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Enrolment {
  id              String    @id @default(uuid())
  userId          String
  courseId        String
  orderId         String?
  accessType      String    @default("PURCHASE") // PURCHASE, FREE, MANUAL_GRANT
  startDate       DateTime  @default(now())
  endDate         DateTime? // null = lifetime
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  grantedByUserId String?
  grantReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Order?    @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
}

model Refund {
  id                String   @id @default(uuid())
  orderId           String   @unique
  processedByUserId String
  amount            Float
  reason            String
  status            String   @default("COMPLETED")
  createdAt         DateTime @default(now())

  order             Order    @relation(fields: [orderId], references: [id])
  processedBy       User     @relation("StaffRefunds", fields: [processedByUserId], references: [id])
}

model DoubtTicket {
  id          String         @id @default(uuid())
  studentId   String
  mentorId    String?
  courseId    String
  lessonId    String?
  title       String
  description String
  status      String         @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  student     User           @relation("StudentDoubts", fields: [studentId], references: [id], onDelete: Cascade)
  mentor      User?          @relation("MentorDoubts", fields: [mentorId], references: [id])
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?        @relation(fields: [lessonId], references: [id])
  messages    DoubtMessage[]
}

model DoubtMessage {
  id             String      @id @default(uuid())
  doubtId        String
  senderId       String
  message        String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  createdAt      DateTime    @default(now())

  doubt          DoubtTicket @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CourseForumTopic {
  id        String            @id @default(uuid())
  courseId  String
  authorId  String
  title     String
  content   String
  isPinned  Boolean           @default(false)
  isLocked  Boolean           @default(false)
  isHidden  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts     CourseForumPost[]
}

model CourseForumPost {
  id        String           @id @default(uuid())
  topicId   String
  authorId  String
  content   String
  isHidden  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  topic     CourseForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ModerationReport {
  id              String    @id @default(uuid())
  reporterId      String
  targetType      String // FORUM_TOPIC, FORUM_POST, DOUBT_MESSAGE
  targetId        String
  reason          String
  status          String    @default("PENDING") // PENDING, DISMISSED, ACTION_TAKEN
  resolvedByUserId String?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reporter        User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy      User?     @relation("ModeratorActions", fields: [resolvedByUserId], references: [id])
}

model LiveClass {
  id              String   @id @default(uuid())
  courseId        String
  mentorId        String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  meetingUrl      String
  status          String   @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentor          User     @relation("MentorLiveClasses", fields: [mentorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // ENROLMENT, DOUBT, ANNOUNCEMENT, SYSTEM
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceFlag {
  id              String   @id @default(uuid())
  featureKey      String   @unique // PLATFORM_GLOBAL, PAYMENT_CHECKOUT, COMMUNITY_FORUM, LIVE_CLASSES
  isEnabled       Boolean  @default(false) // true means MAINTENANCE IS ACTIVE
  message         String   @default("This service is undergoing scheduled maintenance.")
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
}

// PRD Section 15.3 Feedback & Ratings
model Feedback {
  id               String   @id @default(uuid())
  referenceNumber  String   @unique // e.g. "FDBK-2026-1001"
  userId           String?
  courseId         String?
  category         String   @default("GENERAL") // GENERAL, SUGGESTION, BUG_REPORT, COURSE_FEEDBACK
  title            String
  description      String
  rating           Int?     // 1 to 5 stars
  attachmentUrl    String?
  status           String   @default("NEW") // NEW, UNDER_REVIEW, PLANNED, RESOLVED, DECLINED
  internalNotes    String?  // Staff only (hidden from student)
  assignedToUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignedTo       User?    @relation("StaffAssignedFeedbacks", fields: [assignedToUserId], references: [id])
}

// PRD Section 15.4 Help & Support Tickets
model SupportTicket {
  id               String                 @id @default(uuid())
  ticketNumber     String                 @unique // e.g. "SUP-2026-5001"
  userId           String?                // nullable for pre-login account recovery tickets
  requesterEmail   String
  requesterName    String
  category         String                 @default("GENERAL_INQUIRY") // ACCOUNT_ACCESS, PAYMENT_BILLING, COURSE_CONTENT, TECHNICAL_BUG, GENERAL_INQUIRY
  subject          String
  description      String
  status           String                 @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_USER, ESCALATED, RESOLVED
  priority         String                 @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedToUserId String?
  internalNotes    String?                // Staff only (hidden from requester)
  feedbackRating   Int?                   // 1 to 5 post-resolution rating
  feedbackComment  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTo       User?                  @relation("StaffAssignedTickets", fields: [assignedToUserId], references: [id])
  messages         SupportTicketMessage[]
}

model SupportTicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  senderId      String?
  senderRole    String        @default("USER") // USER, STAFF
  message       String
  attachmentUrl String?
  isInternal    Boolean       @default(false) // Staff internal note
  createdAt     DateTime      @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender        User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
}

// PRD Section 15.4 Searchable FAQs
model FaqArticle {
  id         String   @id @default(uuid())
  category   String   // REGISTRATION, PAYMENTS_REFUNDS, COURSE_ACCESS, LIVE_CLASSES, CERTIFICATES, ACCOUNT_SECURITY
  questionEn String
  answerEn   String
  questionHi String
  answerHi   String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
